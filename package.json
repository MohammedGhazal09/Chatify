{
  "name": "live-chat",
  "version": "1.0.0",
  "description": "Live Chat app using MERN stack",
  "main": "index.js",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "test": "npm run quality",
    "quality": "npm run quality:backend && npm run quality:frontend",
    "quality:backend": "npm --prefix Backend/Chatify test -- --run",
    "quality:frontend": "npm run quality:frontend:test && npm run quality:frontend:lint && npm run quality:frontend:build",
    "quality:frontend:test": "npm --prefix Frontend/Chatify test -- --run",
    "quality:frontend:lint": "npm --prefix Frontend/Chatify run lint",
    "quality:frontend:build": "npm --prefix Frontend/Chatify run build",
    "smoke:local": "npm --prefix Frontend/Chatify run test:ui --",
    "smoke:prod": "npm --prefix Frontend/Chatify run test:e2e:prod --",
    "evidence:production": "node scripts/production-evidence-check.mjs",
    "evidence:release-candidate": "node scripts/production-evidence-check.mjs --phase=50",
    "ops:check": "node scripts/ops-check.mjs",
    "bootstrap:backend": "npm --prefix Backend/Chatify ci",
    "bootstrap:frontend": "npm --prefix Frontend/Chatify ci",
    "bootstrap:full": "npm run bootstrap:backend && npm run bootstrap:frontend",
    "doctor": "node scripts/security/phase1-doctor.mjs",
    "security:phase1:test": "node --test scripts/security/__tests__/phase1-*.test.mjs",
    "security:phase1:generate": "node scripts/security/phase1-inventory.mjs --write",
    "security:phase1:check": "node scripts/security/phase1-inventory.mjs --check",
    "security:phase1:reproduce": "node scripts/security/phase1-reproduce.mjs",
    "security:phase2:test": "node --test scripts/security/__tests__/phase2-threat-model.test.mjs",
    "security:phase2:generate": "node scripts/security/phase2-threat-model.mjs --write",
    "security:phase2:check": "node scripts/security/phase2-threat-model.mjs --check",
    "security:phase2:reproduce": "node scripts/security/phase2-reproduce.mjs",
    "security:phase3:test": "node --test scripts/security/__tests__/phase3-*.test.mjs",
    "security:phase3:generate": "node scripts/security/phase3-secret-scan.mjs --write",
    "security:phase3:check": "node scripts/security/phase3-secret-scan.mjs --check",
    "security:phase3:reproduce": "node scripts/security/phase3-reproduce.mjs",
    "security:phase4:test": "node --test scripts/security/__tests__/phase4-*.test.mjs",
    "security:phase4:generate": "node scripts/security/phase4-dependency-policy.mjs --write",
    "security:phase4:check": "node scripts/security/phase4-dependency-policy.mjs --check",
    "security:phase4:reproduce": "node scripts/security/phase4-reproduce.mjs",
    "security:phase5:test": "node --test scripts/security/__tests__/phase5-*.test.mjs",
    "security:phase5:generate": "node scripts/security/phase5-authentication-policy.mjs --write",
    "security:phase5:check": "node scripts/security/phase5-authentication-policy.mjs --check",
    "security:phase5:reproduce": "node scripts/security/phase5-reproduce.mjs"
  },
  "author": "Mohammed Ghazal",
  "license": "ISC"
}
